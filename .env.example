# ── Required ────────────────────────────────────────────────────────────────
# Supabase Postgres (Dashboard → Connect → ORMs → Prisma).
# Pooled connection for the app (port 6543, transaction mode):
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection, used only by `prisma db push` (port 5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Password/PIN to unlock the HUD + admin panel (min 4 chars).
JARVIS_PASSWORD="change-me"

# 32+ random chars. Signs the session cookie AND encrypts API keys in the DB.
# Generate: openssl rand -base64 48
# WARNING: changing it makes stored API keys unreadable (re-enter them in /admin).
AUTH_SECRET=""

# Bearer token for /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=""

# Public URL of the app (used for Google OAuth redirect + webhooks).
APP_URL="http://localhost:3000"

# ── Optional: anything below can instead be set in /admin ──────────────────
# Values set here are used as fallbacks when the admin field is empty.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# VAPI_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# WHATSAPP_TOKEN=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
