# ── Required ────────────────────────────────────────────────────────────────
# Used by `next dev` (local). On Cloudflare, set these as Worker secrets instead
# (Dashboard → your Worker → Settings → Variables and Secrets), or for
# `npm run preview` put them in .dev.vars.
#
# Only Prisma CLI tooling reads DATABASE_URL; the app itself uses the D1 binding.
DATABASE_URL="file:./dev.db"

# Password/PIN to unlock the HUD + admin panel (min 4 chars).
JARVIS_PASSWORD="change-me"

# 32+ random chars. Signs the session cookie AND encrypts API keys in the DB.
# Generate: openssl rand -base64 48
# WARNING: changing it makes stored API keys unreadable (re-enter them in /admin).
AUTH_SECRET=""

# Bearer token for /api/cron/* (Cloudflare Cron Triggers use it automatically).
CRON_SECRET=""

# Public URL (Google OAuth redirect + webhooks). Optional: defaults to the
# address the request came in on. Set it if you use a custom domain.
APP_URL="http://localhost:3000"

# ── Optional: anything below can instead be set in /admin ──────────────────
# Values set here are used as fallbacks when the admin field is empty.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# VAPI_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# WHATSAPP_TOKEN=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
