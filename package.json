{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cron:local": "tsx scripts/local-cron.ts",
    "postinstall": "prisma generate",
    "icons": "node scripts/make-icons.mjs",
    "preview": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy && wrangler d1 migrations apply jarvis-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jarvis-db --remote",
    "db:seed:local": "wrangler d1 execute jarvis-db --local --file=scripts/seed.local.sql",
    "setup": "npm run db:migrate:local && npm run db:seed:local",
    "build:cf": "opennextjs-cloudflare build && node scripts/embed-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/generative-ai": "^0.24.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  }
}
