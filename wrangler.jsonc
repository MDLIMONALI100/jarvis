{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  // Custom entry: OpenNext's fetch handler + a `scheduled` handler for cron.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Cloudflare D1 (SQLite), region APAC.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-db",
      "database_id": "0300b297-4d48-4349-b42d-b30d3a48ab54",
      "migrations_dir": "migrations"
    }
  ],

  // Free Cron Triggers (replaces Vercel cron / cron-job.org).
  // Meeting reminders every 5 min, inbox triage every 15 min.
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *"]
  }
}
